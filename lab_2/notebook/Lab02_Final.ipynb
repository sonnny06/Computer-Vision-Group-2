    "          (39, 44, \"Sáng không đều\"), (45, 50, \"Gradient/texture\")]\n",
    "\n",
    "\n",
    "def group_of(name):\n",
    "    k = int(name[:2])\n",
    "    return next(lab for lo, hi, lab in GROUPS if lo <= k <= hi)\n",
    "\n",
    "\n",
    "rows = []\n",
    "for p in sorted(INPUT_DIR.glob(\"*.png\")):\n",
    "    g = read_img(p.name)\n",
