    "\n",
    "def sobel(img):\n",
    "    gx, gy = (cv2.Sobel(img, cv2.CV_32F, *d, ksize=3) for d in [(1, 0), (0, 1)])\n",
    "    return gx, gy, np.hypot(gx, gy)\n",
    "\n",
    "def prewitt(img):\n",
    "    gx = cv2.filter2D(img, cv2.CV_32F, kx_prewitt)\n",
    "    gy = cv2.filter2D(img, cv2.CV_32F, kx_prewitt.T)\n",
    "    return gx, gy, np.hypot(gx, gy)\n",
